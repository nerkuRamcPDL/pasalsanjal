APP_NAME=MVMarket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
APP_URL=http://localhost:8000
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mvmarket
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mvmarket.test"
MAIL_FROM_NAME="${APP_NAME}"

# Security (SRS 9.x)
BCRYPT_ROUNDS=12
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=10

# Payment gateways — eSewa ships with published sandbox test credentials by
# default (see App\Services\Payments\EsewaGateway); leave blank for sandbox.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
PAYMENT_SANDBOX=true

VITE_APP_NAME="${APP_NAME}"
